+void Engine::ft_dump(const std::string& in, const std::string& out, u64 maxRecs, u64 skip) const {
+    FILE* fi = std::fopen(in.c_str(), "rb");
+    FILE* fo = std::fopen(out.c_str(), "ab");
+    if (!fi || !fo) { sync_cout << "info string ftdump: cannot open files" << sync_endl; return; }
+    std::fseek(fi, long(skip * sizeof(Research::Rec)), SEEK_SET);
+    auto accumulators = std::make_unique<Eval::NNUE::AccumulatorStack>();
+    auto caches       = std::make_unique<Eval::NNUE::AccumulatorCaches>(*network);
+    Research::FtRec fr;
+    u64 done = 0, skipped = 0;
+    while (done < maxRecs && std::fread(&fr.rec, sizeof fr.rec, 1, fi) == 1)
+    {
+        StateInfo st;
+        Position  p;
+        p.set(Research::rec_to_fen(fr.rec), false, &st);
+        if (p.checkers()) { ++skipped; continue; }
+        accumulators->reset();
+        int bucket;
+        fr.sfEval = int16_t(std::clamp(int(network->transform_dump(p, *accumulators, *caches, fr.ft, bucket)), -32000, 32000));
+        fr.bucket = uint8_t(bucket);
+        fr.pad    = 0;
+        std::fwrite(&fr, sizeof fr, 1, fo);
+        ++done;
+    }
+    std::fclose(fi);
+    std::fclose(fo);
+    sync_cout << "info string ftdump done " << done << " skipped " << skipped << sync_endl;
+}
