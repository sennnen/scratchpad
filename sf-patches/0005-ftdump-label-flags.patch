+std::string rec_to_fen(const Rec& r) {
+    static const char* pc = " PNBRQK  pnbrqk";
+    std::string        fen;
+    for (int rank = 7; rank >= 0; --rank)
+    {
+        int empty = 0;
+        for (int file = 0; file < 8; ++file)
+        {
+            int s = rank * 8 + file, code = (r.board[s >> 1] >> ((s & 1) * 4)) & 15;
+            if (!code) { ++empty; continue; }
+            if (empty) { fen += char('0' + empty); empty = 0; }
+            fen += pc[code];
+        }
+        if (empty) fen += char('0' + empty);
+        if (rank) fen += '/';
+    }
+    fen += r.stm ? " b - - " : " w - - ";
+    fen += std::to_string(r.rule50) + " 1";
+    return fen;
+}
